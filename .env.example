# ── Fichier d'exemple — NE PAS mettre de vraies valeurs ici ──────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# .env est ignoré par Git (.gitignore ligne "*.env" / ".env").
# Partager les vraies valeurs via Bitwarden (coffre partagé), jamais Discord/Jira.

# PostgreSQL
PG_USER=ticketflow
PG_PASSWORD=

# Keycloak admin console
KC_ADMIN=admin
KC_ADMIN_PASSWORD=

# Mot de passe que Keycloak utilise pour se connecter à PostgreSQL (DB : keycloak)
KC_DB_PASSWORD=
