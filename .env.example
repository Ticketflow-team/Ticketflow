# ── Fichier d'exemple — NE PAS mettre de vraies valeurs ici ──────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# .env est ignore par Git.
# Partager les vraies valeurs via Bitwarden, jamais Discord/Jira.

# PostgreSQL — utilise aussi par Keycloak (base "keycloak" separee)
PG_USER=ticketflow
PG_PASSWORD=

# Keycloak admin console
KC_ADMIN=admin
KC_ADMIN_PASSWORD=

# External LLM API (Person D — never put a real key here)
LLM_API_KEY=
LLM_MODEL=
